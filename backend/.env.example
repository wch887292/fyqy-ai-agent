# ==========================================================
# 飞虹智-企业AI一站式平台 V1.0 后端环境变量
# 研发主体：晋江市飞虹智科技企业管理有限公司 · 飞扬企源研发中心
# ==========================================================

# ---------- 运行模式 ----------
# dev  = 本地轻量模式（SQLite + 内存向量 + 本地磁盘），零外部依赖，开箱即跑
# prod = 生产模式（MySQL + Milvus + MinIO），对应 docker-compose.yml
APP_MODE=dev
APP_PORT=8080
APP_NAME=飞虹智-企业AI一站式平台

# ---------- 安全 ----------
JWT_SECRET=fae-feihongzhi-2026-change-me-in-production
JWT_EXPIRES_IN=12h

# ---------- 数据库：sqlite | mysql ----------
DB_DRIVER=sqlite
DB_SQLITE_FILE=./data/fae_enterprise.db
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123456
DB_NAME=fae_enterprise
# 首次启动自动建表（dev 建议 true，prod 用 init.sql 建表后设 false）
DB_SYNCHRONIZE=true

# ---------- 向量库：memory | milvus ----------
VECTOR_DRIVER=memory
MILVUS_HOST=milvus
MILVUS_PORT=19530
VECTOR_DIM=512

# ---------- 文件存储：local | minio ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=Minio@123456
MINIO_BUCKET=fae

# ---------- 大模型 OpenClaw ----------
# 留空则自动降级为内置规则引擎（Mock），保证无网络/无密钥也能完整演示
# 兼容 OpenAI Chat Completions 协议，填写 OpenClaw 私有化地址即可
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL_NAME=openclaw-enterprise
LLM_TIMEOUT_MS=60000
# Embedding 接口（留空则用内置轻量向量算法，中文分词哈希+TF加权）
EMBEDDING_API_ENDPOINT=
EMBEDDING_MODEL_NAME=

# ---------- 业务规则（文档强约束） ----------
# 客户列表固定每页条数
CRM_PAGE_SIZE=10
# 客户逾期未跟进天数阈值（触发风险预警）
CRM_FOLLOW_OVERDUE_DAYS=7
