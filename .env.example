# ==========================================================
# 飞虹智-企业AI一站式平台 V1.0 · docker compose 编排变量
# 研发主体：晋江市飞虹智科技企业管理有限公司 · 飞扬企源研发中心
#
# 用法：cp .env.example .env 后按需修改，再执行 docker compose up -d
# 注意：本文件仅供 docker-compose.yml 使用；本地 dev 模式请用 backend/.env
# ==========================================================

# ---------- 对外端口 ----------
# 浏览器访问入口
FRONTEND_PORT=8000
# 后端端口，如无需外部直连可注释掉 docker-compose 中的 ports 映射
BACKEND_PORT=8080
MYSQL_PORT=3306
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530

# ---------- 安全（上线务必修改） ----------
JWT_SECRET=fae-feihongzhi-2026-change-me-in-production
JWT_EXPIRES_IN=12h

# ---------- MySQL ----------
DB_NAME=fae_enterprise
DB_PASSWORD=Root@123456

# ---------- MinIO ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=Minio@123456
MINIO_BUCKET=fae

# ---------- Milvus ----------
VECTOR_DIM=512

# ---------- 大模型 OpenClaw ----------
# 全部留空 => 自动降级为内置规则引擎，功能完整可演示，仅文案为模板生成
# 填写后 => 走真实大模型，兼容 OpenAI Chat Completions 协议
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL_NAME=openclaw-enterprise
LLM_TIMEOUT_MS=60000
EMBEDDING_API_ENDPOINT=
EMBEDDING_MODEL_NAME=

# ---------- 演示数据 ----------
# true  = 空库时自动写入「晋江华祥鞋材科技」整套演示数据
# false = 正式交付客户时使用，仅建表不塞数据
SEED_DEMO=true
